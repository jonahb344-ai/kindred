rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ─── Public user profiles ────────────────────────────────────────────────
    // Public fields only (name, username, bio, photoUrl, score, etc.).
    // Email, phone and FCM tokens live in users/{uid}/private, owned by the user.
    match /users/{uid} {
      // Points are only ever handed out 5 at a time (10 on weekends), whether you're
      // logging your own act or someone is thanking you. Capping the movement per write
      // stops anyone from typing their own score up to a million and topping the
      // leaderboard, while still letting every real award through.
      function scoreBumpOk() {
        let before = resource.data;
        let after = request.resource.data;
        let beforeScore = before.keys().hasAll(['kindnessScore']) ? before.kindnessScore : 0;
        let beforeActs = before.keys().hasAll(['actsCompleted']) ? before.actsCompleted : 0;
        return after.kindnessScore is int
          && after.actsCompleted is int
          && after.kindnessScore >= beforeScore
          && after.kindnessScore - beforeScore <= 10
          && after.kindnessScore <= 10000
          && after.actsCompleted - beforeActs <= 1;
      }

      allow read: if signedIn();
      allow create: if signedIn() && uid == request.auth.uid;
      allow update: if signedIn() && (
        // editing your own profile -- free to change anything, but the points have to
        // move in believable steps like everyone else's
        (uid == request.auth.uid && (
          !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['kindnessScore', 'actsCompleted'])
          || scoreBumpOk()
        ))
        // The points-awarding flow lets a requester update a volunteer's
        // gamification fields only (no PII), in believable steps.
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['kindnessScore', 'level', 'actsCompleted', 'streak', 'lastActDate'])
          && scoreBumpOk()
        )
      );
      allow delete: if signedIn() && uid == request.auth.uid;

      // ─── Private data (email, phone, FCM token) ────────────────────────────
      match /private/{doc} {
        allow read, write: if signedIn() && uid == request.auth.uid;
      }

      // ─── Action history (shown on public profiles) ─────────────────────────
      match /history/{entry} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == request.auth.uid;
        allow update, delete: if signedIn() && uid == request.auth.uid;
      }
    }

    // ─── Requests ────────────────────────────────────────────────────────────
    match /requests/{id} {
      function isRequester() { return resource.data.requesterId == request.auth.uid; }
      function isVolunteer() { return resource.data.volunteerId == request.auth.uid; }
      function isParticipant() { return signedIn() && (isRequester() || isVolunteer()); }

      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.status == 'open' || isRequester() || isVolunteer()
      );
      allow update: if signedIn() && (
        // Either participant completes the request, or the requester later
        // confirms a volunteer's self-reported completion. A completed act only
        // counts toward rewards once the RECIPIENT confirms it, and only the
        // requester can set recipientConfirmed, so a volunteer can never confirm
        // their own help.
        (isParticipant()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'completedBy', 'recipientConfirmed', 'recipientConfirmedAt'])
          && request.resource.data.status == 'completed'
          && (request.resource.data.get('recipientConfirmed', false) == false
              || resource.data.get('recipientConfirmed', false) == true
              || isRequester()))
        ||
        // A volunteer claims an open request
        (resource.data.status == 'open'
          && request.resource.data.status == 'claimed'
          && request.resource.data.volunteerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'volunteerId', 'volunteerName', 'claimedAt']))
      );
      allow delete: if isParticipant();
    }

    // ─── Chats and messages (participants only) ──────────────────────────────
    // NOTE: do NOT use `.exists` on get() results — it always evaluates to
    // false on this project and breaks all participant checks. Field access
    // on get() (e.g. .data.requesterId) works; a missing request doc makes
    // .data null and the comparison fails closed (deny), which is intended.
    match /chats/{chatId} {
      function chatRequest() {
        return get(/databases/$(database)/documents/requests/$(chatId));
      }
      function chatParticipant() {
        return signedIn()
          && chatRequest().data != null
          && (chatRequest().data.requesterId == request.auth.uid
              || chatRequest().data.volunteerId == request.auth.uid);
      }
      function chatHasMe() {
        return signedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      allow read, write: if chatParticipant() || chatHasMe();

      match /messages/{messageId} {
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && (chatParticipant()
               || chatHasMe()
               || exists(/databases/$(database)/documents/chats/$(chatId)));
        allow read, update, delete: if chatParticipant() || chatHasMe();
      }
    }

    // ─── Notifications (owner only; chat cleanup by participants) ────────────
    match /notifications/{id} {
      function notifChatParticipant() {
        return resource.data.chatId != null
          && (get(/databases/$(database)/documents/requests/$(resource.data.chatId)).data.requesterId == request.auth.uid
              || get(/databases/$(database)/documents/requests/$(resource.data.chatId)).data.volunteerId == request.auth.uid);
      }

      // Writing one used to be open to any signed-in user, which meant anyone could
      // push fake notifications into anyone else's inbox (fake "someone claimed your
      // request" messages, phishing links, spam). Two conditions now apply: the writer
      // has to actually be one of the two people on the request the notification is
      // about, AND the recipient (toUid) has to be the OTHER participant on that same
      // request — so you can't reuse a request you're on to notify a random stranger.
      // You also can't notify yourself. Requests that don't exist fail closed.
      function notifRequest() {
        return get(/databases/$(database)/documents/requests/$(request.resource.data.requestId));
      }
      function notifRelatedParticipant() {
        return request.resource.data.requestId is string
          && (
            (notifRequest().data.requesterId == request.auth.uid
              && request.resource.data.toUid == notifRequest().data.volunteerId)
            || (notifRequest().data.volunteerId == request.auth.uid
              && request.resource.data.toUid == notifRequest().data.requesterId)
          );
      }

      allow create: if signedIn()
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && notifRelatedParticipant();
      allow read, update: if signedIn()
        && (resource.data.toUid == request.auth.uid || notifChatParticipant());
      allow delete: if signedIn()
        && (resource.data.toUid == request.auth.uid || notifChatParticipant());
    }

    // ─── Reports (write only; read restricted to server/admin) ───────────────
    match /reports/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // ─── Community feed ──────────────────────────────────────────────────────
    match /feed/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ─── Thank-you notes ─────────────────────────────────────────────────────
    match /thank_you_notes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // ─── Server-only documents (written by the Worker's service account) ─────
    // Single-use admin picker links and the recorded monthly winners. Clients must
    // never read these: a readable adminTokens doc would hand out a working link.
    match /adminTokens/{token} {
      allow read, write: if false;
    }
    match /rewards/{month} {
      allow read, write: if false;
    }
  }
}
