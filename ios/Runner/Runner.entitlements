<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple — required by App Review Guideline 4.8 (the app offers
	     Google Sign-In). The capability must ALSO be enabled on the App ID in the
	     Apple Developer portal, or signing will fail.
	     IMPORTANT: this MUST be an <array> containing "Default", not a plain
	     <string>. Apple's entitlement is an array, and a string value is not
	     recognised at runtime — Sign in with Apple then fails with
	     ASAuthorizationError error 1000 (unknown). -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Remote notifications (FCM). The value is swapped to "development" by Xcode
	     for debug builds automatically; distribution profiles expect "production". -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
