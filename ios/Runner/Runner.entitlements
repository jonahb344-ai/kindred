<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple — required by App Review Guideline 4.8 (the app offers
	     Google Sign-In). The capability must ALSO be enabled on the App ID in the
	     Apple Developer portal, or signing will fail. -->
	<key>com.apple.developer.applesignin</key>
	<string>Default</string>
	<!-- Remote notifications (FCM). The value is swapped to "development" by Xcode
	     for debug builds automatically; distribution profiles expect "production". -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
